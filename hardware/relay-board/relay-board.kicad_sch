	(text "NO 33-34 + NO 43-44 in series inside each relay, then K1 in series with K2:\n4 gaps split the DC arc.  Nothing may bridge these contacts (no TVS, snubber, LED).\nFit the flyback diode / TVS at the LOAD (contactor or relay coil)."
		(exclude_from_sim no)
		(at 15.24 265.43 0)
		(effects (font (size 1.3 1.3)) (justify left top))
		(uuid "cdf6f7db-ff59-51b1-9eb0-4e1d186f0ce9")
	)
	(text "NO 33-34"
		(exclude_from_sim no)
		(at 52.07 256.54 0)
		(effects (font (size 1.3 1.3)) (justify left top))
		(uuid "d2f3b424-cf96-5871-87df-fa863958df3a")
	)
	(text "NO 43-44"
		(exclude_from_sim no)
		(at 95.25 256.54 0)
		(effects (font (size 1.3 1.3)) (justify left top))
		(uuid "829dad9b-466c-506c-baec-a36edbb6056d")
	)
	(text "NO 33-34"
		(exclude_from_sim no)
		(at 148.59 256.54 0)
		(effects (font (size 1.3 1.3)) (justify left top))
		(uuid "b43dd932-b18b-5431-a76b-88d81024ea8c")
	)
	(text "NO 43-44"
		(exclude_from_sim no)
		(at 191.77 256.54 0)
		(effects (font (size 1.3 1.3)) (justify left top))
		(uuid "82cb780c-f6d5-5941-a4b1-3a3e29d4e232")
	)
	(text "HOW IT WORKS"
		(exclude_from_sim no)
		(at 294.64 20.32 0)
		(effects (font (size 2.0 2.0) bold) (justify left top))
		(uuid "055812a4-f5c5-5adb-9298-be814e895eb8")
	)
	(text "Fail-safe: de-energized = loop open.\nPower loss, reset, floating GPIO or a broken\nwire all leave both relays released.\n\nEach relay is force-guided (EN 61810-3 type A):\nif a NO contact welds, every NC contact of that\nrelay stays >= 0.5 mm open.  The NC mirror\ntherefore proves the loop contacts released.\n\nCommanded 0, SNS reads 0:  released, healthy.\nCommanded 1, SNS reads 1:  pulled in, healthy.\nCommanded 0, SNS reads 1:  WELD or coil stuck on.\n   The partner relay stops the robot; raise fault.\nCommanded 1, SNS reads 0:  did not pull in (safe).\n\nRe-arm only after BOTH SNS read 0.\n\nK1 = channel A = core 0 (IO39 drive, IO40 sense)\nK2 = channel B = core 1 (IO41 drive, IO42 sense)\nK unit letters: A coil, B/C NC mirror, D/E NO loop."
		(exclude_from_sim no)
		(at 295.91 27.94 0)
		(effects (font (size 1.4 1.4)) (justify left top))
		(uuid "4e9c8bc7-df17-527a-bec3-613b511d26a9")
	)
	(text "MECHANICAL"
		(exclude_from_sim no)
		(at 294.64 116.84 0)
		(effects (font (size 2.0 2.0) bold) (justify left top))
		(uuid "2bf14976-a92e-59a3-8eaa-839d415af400")
	)
	(text "M3 holes match the 44.86 x 33.57 mm standoff\npattern in machine-casing.FCStd."
		(exclude_from_sim no)
		(at 295.91 124.46 0)
		(effects (font (size 1.3 1.3)) (justify left top))
		(uuid "91115ac2-cd85-508a-b6c0-f3ff9ebb4a99")
	)
