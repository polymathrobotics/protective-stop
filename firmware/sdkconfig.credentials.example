# MicroLink Credentials — DO NOT commit this file!
#
# 1. Copy this file to sdkconfig.credentials:
#      cp sdkconfig.credentials.example sdkconfig.credentials
# 2. Edit sdkconfig.credentials with your real values
# 3. Run: idf.py build
#
# These values are only read when sdkconfig is (re)generated. After editing
# this file on an existing build tree: rm sdkconfig && idf.py build
# Verify: grep CONFIG_ML_TAILSCALE_AUTH_KEY sdkconfig
#
# Step-by-step: docs/QUICKSTART.md

# ---- Required ---------------------------------------------------------------

# Tailscale auth key: REUSABLE, not ephemeral, pre-approved.
# https://login.tailscale.com/admin/settings/keys
CONFIG_ML_TAILSCALE_AUTH_KEY="tskey-auth-XXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Protects http://<remote>/admin/ and the role/operator endpoints.
CONFIG_ML_ADMIN_PASSWORD="your-admin-password"

# ---- Optional: WiFi ---------------------------------------------------------
# Not needed when the remote is on Ethernet or the USB tether. Leave empty to
# disable WiFi station mode.
CONFIG_ML_WIFI_SSID=""
CONFIG_ML_WIFI_PASSWORD=""

# ---- Optional: fleet management backend -------------------------------------
# A site-specific OTA / check-in server (not included in this repository).
# Leave all three empty unless you run one.
CONFIG_ML_OTA_API_KEY=""
CONFIG_ML_FLEET_SERVER_IP=""
CONFIG_ML_OTA_BACKEND_URL=""
