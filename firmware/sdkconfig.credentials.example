# MicroLink Credentials — DO NOT commit this file!
#
# 1. Copy this file to sdkconfig.credentials:
#      cp sdkconfig.credentials.example sdkconfig.credentials
# 2. Edit sdkconfig.credentials with your real values
# 3. Run: idf.py build

CONFIG_ML_WIFI_SSID="your-wifi-ssid"
CONFIG_ML_WIFI_PASSWORD="your-wifi-password"
CONFIG_ML_TAILSCALE_AUTH_KEY="tskey-auth-XXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
CONFIG_ML_ADMIN_PASSWORD="your-admin-password"

# OTA backend bearer token; must match the key configured in your
# management backend (see CONFIG_ML_OTA_BACKEND_URL below).
CONFIG_ML_OTA_API_KEY="your-ota-backend-api-key"

# Centralized configuration management / OTA backend (optional; site-specific).
# The pinned management-server peer and the OTA poll target.
CONFIG_ML_FLEET_SERVER_IP="100.x.y.z"
CONFIG_ML_OTA_BACKEND_URL="http://100.x.y.z"
