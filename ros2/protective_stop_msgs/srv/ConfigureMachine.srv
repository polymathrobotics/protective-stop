# Runtime reconfiguration of the machine timing envelope. Values <= 0 mean
# "leave unchanged". The node's validator rejects any change that would LOOSEN
# the safety envelope past the compile-time floor (can only tighten).
int64 heartbeat_ms        # advertised per-remote heartbeat window (<=0 = keep)
int32 max_missed          # missed-heartbeat tolerance (<=0 = keep)
int64 min_stop_ms         # min STOP->OK arming delay (<0 = keep). Subject to the
                          # node's safety floor: values below it are rejected
                          # (the floor cannot be disabled at runtime).
---
bool success
string message
int64 heartbeat_ms        # values in effect after the call
int32 max_missed
int64 min_stop_ms
