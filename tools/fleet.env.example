#
# Copy to tools/fleet.env (GITIGNORED — fleet addresses and credentials are
# proprietary and must never be committed) and fill in.

# The machine node (flashed FIRST; the cycle waits for it before remotes).
MACHINE_IP=100.64.0.1

# Every remote to flash, space-separated.
REMOTE_IPS="100.64.0.2 100.64.0.3"

# Device admin HTTP basic-auth.
DEVICE_AUTH=admin:changeme

# Optional: firmware registry (leave unset to skip upload).
#REGISTRY_URL=http://registry.example
#REGISTRY_AUTH=user:pass

# Optional: per-lineage ELF archive dir (leave unset to skip).
# Coredump decode requires the EXACT build's ELF — archive every fleet build.
#ELF_ARCHIVE_DIR=/path/to/elf-archive
