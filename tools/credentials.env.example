# pstop credentials — DO NOT commit tools/credentials.env!
#
# Flashed per device into an encrypted partition; never compiled into firmware.
#   cp tools/credentials.env.example tools/credentials.env
#   $EDITOR tools/credentials.env
#   tools/flash_pstop.sh --remote            # or flash_station.py
#
# KEY=value, one per line. Values may be double-quoted. Empty values are left
# unset. Each value is at most 128 bytes. An old firmware/sdkconfig.credentials
# (CONFIG_ML_ prefixes) is accepted as-is.
#
# Step-by-step: docs/QUICKSTART.md

# ---- Required ---------------------------------------------------------------

# Tailscale auth key: REUSABLE (re-sent on every re-registration), not
# ephemeral (the node identity is kept in NVS), pre-approved if device approval
# is on. Disable key expiry on the node afterwards, or use a tagged key.
# https://login.tailscale.com/admin/settings/keys
TAILSCALE_AUTH_KEY="tskey-auth-XXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Protects http://<remote>/admin/ and the role/operator endpoints (user
# "admin"). Unset, the unit uses the public default "microlink".
ADMIN_PASSWORD="your-admin-password"

# ---- Optional: WiFi ---------------------------------------------------------
# Not needed when the remote is on Ethernet or the USB tether. The unit cycles
# through the secondary network when the primary fails.
WIFI_SSID=""
WIFI_PASSWORD=""
WIFI_SSID_2=""
WIFI_PASSWORD_2=""

# ---- Optional: fleet management backend -------------------------------------
# A site-specific OTA / check-in server (not included in this repository).
# FLEET_SERVER_IP is always allowed through the peer allowlist.
FLEET_SERVER_IP=""
OTA_BACKEND_URL=""
OTA_API_KEY=""
