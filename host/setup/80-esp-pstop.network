#
# systemd-networkd: make every pstop USB-NCM tether a port of the pstop-br
# bridge. 79-esp-pstop.rules names each unit esp-pstop<N> (kernel usb<N> index),
# so the glob matches units 0..N with no per-unit file; the bridge itself is
# named pstop-br precisely so this glob cannot match it. Address, DHCP server
# and NAT live on the bridge (79-pstop-br.network). Install to
# /etc/systemd/network/.
#
# The rename applies on each tether's next re-enumeration (power-cycle/replug),
# so until then a chip still appears as enx<mac> — replug once after install.
[Match]
Name=esp-pstop*

[Network]
Bridge=pstop-br
