#
# Keep ModemManager away from the pstop's USB serial interfaces. On every
# download-mode re-enumeration (app 303a:4001 -> USB-JTAG 303a:1001 / ROM CDC
# 303a:0009) ModemManager probes the fresh ttyACM and holds it open, which makes
# esptool fail to flash with "Write timeout" / EPROTO. Tagging the device by
# vendor id tells MM to ignore every pstop USB personality, app or bootloader.
#
# Install: sudo cp to /etc/udev/rules.d/ ; sudo udevadm control --reload
ACTION=="add|change", SUBSYSTEMS=="usb", ATTRS{idVendor}=="303a", ENV{ID_MM_DEVICE_IGNORE}="1"
